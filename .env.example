# Telegram
TELEGRAM_BOT_TOKEN=

# PostgreSQL (inside Docker network)
PGHOST=postgres
PGPORT=5432
PGDATABASE=ai_integrator
PGUSER=ai_integrator
PGPASSWORD=change-me
PGPORT_HOST=5434
NODERED_PORT=1880

# Multi-provider order
AI_PROVIDER_ORDER=groq,gemini,openrouter

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# OpenRouter fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://ai-integrator.local
OPENROUTER_X_TITLE=AI Integrator

# AI tuning
AI_TEMPERATURE=0.2
AI_MEMORY_BATCH_SIZE=8
AI_MEMORY_BATCH_MESSAGES=30
AI_MEMORY_CONTEXT_CHARS=18000
AI_CHAT_TOP_K=12
AI_MEMORY_MESSAGES=10
