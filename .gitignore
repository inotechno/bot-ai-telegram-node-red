# rahasia
.env

# runtime Node-RED (state, cred, node_modules, cache)
node-red/data/*
!node-red/data/.gitkeep
# sumber proyek yang tetap di-commit
!node-red/data/package.json
!node-red/data/package-lock.json
!node-red/data/settings.js
!node-red/data/lib/

# dependensi
node_modules/

# sertifikat lokal (lihat certs/README.txt)
certs/*
!certs/README.txt

# ekspor flow lama (duplikat)
flows/flows (2).json

# cadangan database
backups/
